<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f3f5ef">
    <title>Sign In | ShopEase</title>
    <link rel="stylesheet" href="/css/user_login.css">
</head>
<body class="auth-page">
    <main class="auth-shell">
        <section class="brand-panel" aria-label="ShopEase">
            <a class="brand" href="/products/" aria-label="ShopEase home">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 32 32" fill="none">
                        <path d="M6 11h20l-1.6 16H7.6L6 11Z" fill="currentColor" />
                        <path d="M11 12V9a5 5 0 0 1 10 0v3" stroke="#0d695d" stroke-width="2.2" stroke-linecap="round" />
                        <path d="M12 17h8" stroke="#f2bd54" stroke-width="2" stroke-linecap="round" />
                    </svg>
                </span>
                <span>Shop<span class="brand-accent">Ease.</span></span>
            </a>

            <div class="brand-copy">
                <p class="eyebrow">A LITTLE MORE JOY, EVERY DAY</p>
                <h2>Good finds.<br>Better days.</h2>
                <p>Your favorite things are never far away. Sign in to pick up where you left off.</p>
            </div>

            <div class="brand-art" aria-hidden="true">
                <span class="art-spark spark-one"></span>
                <span class="art-spark spark-two"></span>
                <svg class="shopping-art" viewBox="0 0 360 230" fill="none">
                    <ellipse cx="184" cy="205" rx="115" ry="13" fill="#084f49" fill-opacity=".2" />
                    <circle cx="265" cy="72" r="37" fill="#f2bd54" />
                    <path d="M73 87h211l-17 111H90L73 87Z" fill="#fffdf7" />
                    <path d="M135 91V70a44 44 0 0 1 88 0v21" stroke="#fffdf7" stroke-width="12" stroke-linecap="round" />
                    <path d="m155 133 21 22 43-46" stroke="#168879" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="50" y="132" width="42" height="42" rx="10" transform="rotate(-13 50 132)" fill="#ef846d" />
                    <path d="m67 145 13 14m-5-19 10 12" stroke="#fff8ed" stroke-width="3" stroke-linecap="round" />
                    <path d="M285 135h26v48h-26z" fill="#f5a759" />
                    <path d="M285 135h26l-5-11h-16l-5 11Z" fill="#ffe1a2" />
                </svg>
                <span class="art-caption">A good day, delivered.</span>
            </div>

            <p class="brand-footnote">Thoughtful picks for your everyday.</p>
        </section>

        <section class="auth-content" aria-labelledby="page-title">
            <div class="auth-heading">
                <p class="eyebrow">WELCOME BACK</p>
                <h1 id="page-title">Sign in to your account</h1>
                <p>Good to see you again. Your next favorite is waiting.</p>
            </div>

            <form class="auth-form" action="#" method="post">
                {{#if error}}
                <p class="form-message" role="alert" aria-live="polite">{{error}}</p>
                {{/if}}

                <div class="form-field">
                    <label for="email">Email address</label>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5" width="17" height="14" rx="2.5"/><path d="m4.5 7 7.5 6 7.5-6"/></svg>
                        <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required>
                    </div>
                </div>

                <div class="form-field password-field">
                    <div class="password-heading">
                        <label for="password">Password</label>
                        <label class="visibility-control" for="show-password">
                            <input class="visibility-checkbox" id="show-password" type="checkbox">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12s3.4-6 9.5-6 9.5 6 9.5 6-3.4 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg>
                            <span>Show</span>
                        </label>
                    </div>
                    <div class="input-wrap">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4.5" y="10" width="15" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
                        <input class="password-input" id="password" name="password" type="password" autocomplete="current-password" placeholder="Enter your password" required>
                    </div>
                </div>

                <div class="form-options">
                    <label class="check-control">
                        <input type="checkbox" name="rememberMe">
                        <span class="custom-check" aria-hidden="true"></span>
                        <span>Remember me</span>
                    </label>
                    <a class="text-link" href="#">Forgot password?</a>
                </div>

                <button class="submit-button" type="submit">
                    <span>Log in</span>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                </button>
            </form>

            <p class="auth-switch">New to ShopEase? <a href="/user/register">Create an account</a></p>
            <p class="auth-legal">By continuing, you agree to ShopEase's <a href="#">Terms</a> and <a href="#">Privacy Policy</a>.</p>
        </section>
    </main>
</body>
</html>
