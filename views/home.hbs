<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ShopEase | Home</title>

    <link rel="stylesheet" href="/css/home.css">
</head>

<body>

    <!-- NAVBAR -->
    <header class="navbar">

        <a href="/products/" class="logo">Shop<span>Ease.</span></a>

        <nav aria-label="Main navigation">
            <a href="/products/" class="active" aria-current="page">Home</a>
            <a href="/products/productDetails">Products</a>
            <a href="/products/add">Add Product</a>
        </nav>

        <a href="/products/productDetails" class="nav-btn">
            Explore Products
        </a>

    </header>


    <!-- HERO SECTION -->
    <section class="hero">

        <div class="hero-content">

            <span class="hero-tag">WELCOME TO SHOPEASE</span>

            <h1>
                Everything You Need,
                <span>All in One Place.</span>
            </h1>

            <p>
                Discover quality products at great prices.
                Explore our collection and find something
                perfect for you.
            </p>

            <div class="hero-buttons">
                <a href="/products/productDetails" class="primary-btn">
                    Shop Now →
                </a>

                <a href="/products/add" class="secondary-btn">
                    Add Product
                </a>
            </div>

            <div class="hero-stats">

                <div>
                    <h3>Quality</h3>
                    <p>Products</p>
                </div>

                <div>
                    <h3>Easy</h3>
                    <p>Shopping</p>
                </div>

                <div>
                    <h3>Best</h3>
                    <p>Experience</p>
                </div>

            </div>

        </div>


        <div class="hero-visual">

            <div class="visual-card card-one">
                <span>🛍️</span>
                <h3>Discover More</h3>
                <p>Explore our collection</p>
            </div>

            <div class="visual-card card-two">
                <span>✨</span>
                <h3>Quality Products</h3>
                <p>Made for everyday needs</p>
            </div>

            <div class="visual-circle"></div>

        </div>

    </section>


    <!-- CATEGORIES SECTION -->
    <section class="categories">

        <div class="section-heading">
            <span>EXPLORE</span>
            <h2>Shop With Ease</h2>
            <p>Everything you need, just a click away.</p>
        </div>

        <div class="category-grid">

            <div class="category-card">
                <div class="category-icon">🛒</div>
                <h3>Browse Products</h3>
                <p>Explore all available products in our store.</p>
                <a href="/products/productDetails">Explore →</a>
            </div>

            <div class="category-card">
                <div class="category-icon">📦</div>
                <h3>Product Details</h3>
                <p>Find product information and pricing.</p>
                <a href="/products/productDetails">View Products →</a>
            </div>

            <div class="category-card">
                <div class="category-icon">➕</div>
                <h3>Add Products</h3>
                <p>Add new products to your product collection.</p>
                <a href="/products/add">Add Now →</a>
            </div>

        </div>

    </section>


    <!-- WHY CHOOSE US -->
    <section class="why-section">

        <div class="why-content">
            <span>WHY SHOPEASE?</span>
            <h2>A Simple and Better Shopping Experience.</h2>
            <p>
                We make product discovery simple with an easy-to-use
                interface and organized product information.
            </p>
        </div>

        <div class="why-features">

            <div class="feature">
                <span>✓</span>
                <div>
                    <h3>Easy Navigation</h3>
                    <p>Find products without any hassle.</p>
                </div>
            </div>

            <div class="feature">
                <span>✓</span>
                <div>
                    <h3>Clear Information</h3>
                    <p>View product names and prices easily.</p>
                </div>
            </div>

            <div class="feature">
                <span>✓</span>
                <div>
                    <h3>Simple Interface</h3>
                    <p>A clean experience across devices.</p>
                </div>
            </div>

        </div>

    </section>


    <!-- FOOTER -->
    <footer class="footer">

        <a href="/products/" class="logo">Shop<span>Ease.</span></a>

        <p>Simple shopping. Better experience.</p>

        <span>© 2026 ShopEase. All rights reserved.</span>

    </footer>

</body>

</html>
